{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* The same `@/` alias as tsconfig.app: scripts import src modules that use it */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["vite.config.ts", "scripts"],
  /*
   * Browser harnesses (DOM, JSX) run in Vite pages, not in Node; the jsdom
   * test of the window's code is typed with the app's settings,
   * tsconfig.keys.json
   */
  "exclude": [
    "scripts/pilot/harness",
    "scripts/keys/harness",
    "scripts/cx/harness",
    "scripts/keys/candidates.test.ts"
  ]
}
